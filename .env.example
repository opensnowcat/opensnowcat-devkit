# Copy to .env to override devkit defaults.

# Directory with your Iglu schemas, laid out as <vendor>/<name>/jsonschema/<model>-<revision>-<addition>.
# Relative paths are resolved from this directory. The console serves it to enrich and edits it in place.
SCHEMAS_DIR=./schemas

# Directory the console may browse when you add a folder registry from the UI.
# Defaults to your home directory. Set it to a narrower parent if you prefer.
# HOST_HOME=/Users/me/work

# --- AWS Kinesis (make run-kinesis) ---
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY exported in your shell are used first; keep keys out of this file.
# Otherwise, the profile from ~/.aws used to export credentials. SSO profiles work: run `aws sso login --profile <name>` first.
# AWS_PROFILE=dev
# Region of the streams. Defaults to the profile's region, then us-east-1.
# AWS_REGION=us-west-2
# Stream names, if yours differ from the defaults.
# KINESIS_COLLECTOR_GOOD=collected-good
# KINESIS_COLLECTOR_BAD=collected-bad
# KINESIS_ENRICHED_GOOD=enriched-good
# KINESIS_ENRICHED_BAD=enriched-bad
# Enrich's KCL application name, also the DynamoDB checkpoint table it creates.
# KINESIS_ENRICH_APP_NAME=opensnowcat-enrich-devkit
